# 服务端口
PORT=3000

# MySQL 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clean_plate
DB_USER=root
DB_PASSWORD=your_password

# JWT 密钥
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# 图片上传目录
UPLOAD_DIR=uploads

# AI 识别开关
AI_ENABLED=true
AI_THRESHOLD=0.6

# 百度智能云 - 视觉识别
BAIDU_API_KEY=your_api_key
BAIDU_SECRET_KEY=your_secret_key
# EasyDL 自训练「干净/需要审核/不干净」三分类模型服务名（发布后从服务地址获取）
BAIDU_MODEL_ID=your_model_service_name
