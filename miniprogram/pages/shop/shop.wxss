.points-bar {
  background: linear-gradient(135deg, #fb8c00, #f57c00);
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  color: #fff;
  margin-bottom: 24rpx;
}

.points-bar-label {
  font-size: 28rpx;
  opacity: 0.9;
}

.points-bar-num {
  font-size: 52rpx;
  font-weight: 700;
  margin-left: 20rpx;
}

.orders-link {
  margin-left: auto;
  font-size: 26rpx;
  opacity: 0.9;
}

.product-main {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.product-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
}

.product-desc {
  font-size: 24rpx;
  color: #9e9e9e;
  margin-top: 6rpx;
}

.product-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-cost {
  font-size: 26rpx;
  color: #555;
}

.exchange-btn {
  background: #43a047;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 40rpx;
  line-height: 64rpx;
  height: 64rpx;
  margin: 0;
}

.exchange-btn::after {
  border: none;
}
