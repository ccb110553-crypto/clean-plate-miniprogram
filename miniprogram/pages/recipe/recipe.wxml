<view class="container">
  <view class="tip card">💡 小份菜、半份菜，荤素搭配，吃得饱又不浪费</view>

  <view wx:if="{{recipes.length === 0}}" class="empty">暂无食谱推荐</view>

  <view wx:for="{{recipes}}" wx:key="id" class="card recipe-item">
    <view class="recipe-title">{{item.title}}</view>
    <view class="recipe-desc">{{item.description}}</view>
    <view class="recipe-dishes">
      <view wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="*this" class="dish-tag">{{dish}}</view>
    </view>
    <view class="recipe-foot">
      <text class="tag tag-green" wx:if="{{item.tags}}">{{item.tags}}</text>
      <text class="save-points" wx:if="{{item.pointsSaved}}">预计可省 {{item.pointsSaved}} 积分</text>
    </view>
  </view>
</view>
