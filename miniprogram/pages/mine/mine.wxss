.profile {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #43a047;
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
}

.profile-meta {
  font-size: 24rpx;
  color: #9e9e9e;
  margin-top: 6rpx;
}

.points-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.points-item {
  text-align: center;
  flex: 1;
}

.points-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fb8c00;
}

.points-label {
  font-size: 24rpx;
  color: #9e9e9e;
  margin-top: 6rpx;
}

.points-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

.menu-list {
  padding: 8rpx 28rpx;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}

.menu-row:last-child {
  border-bottom: none;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}

.logout-btn {
  background: #fff;
  color: #e53935;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-top: 32rpx;
}

.logout-btn::after {
  border: none;
}
