.record-item {
  padding: 24rpx;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.record-menu {
  display: flex;
  align-items: center;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.record-menu-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
}

.record-menu-info {
  flex: 1;
}

.record-menu-label {
  font-size: 22rpx;
  color: #9e9e9e;
}

.record-menu-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.record-img {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.record-foot {
  font-size: 26rpx;
}

.reject-reason {
  color: #e53935;
}

.ai-tag {
  color: #9e9e9e;
  font-size: 22rpx;
  margin-top: 8rpx;
}
