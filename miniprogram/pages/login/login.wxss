.login-container {
  padding: 100rpx 48rpx 40rpx;
}

.logo {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  font-size: 120rpx;
  line-height: 1;
}

.logo-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #43a047;
  margin-top: 20rpx;
}

.logo-sub {
  font-size: 26rpx;
  color: #9e9e9e;
  margin-top: 8rpx;
}

.form {
  padding: 40rpx 32rpx;
}

.input {
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 30rpx;
}

.login-btn {
  margin-top: 24rpx;
}

.switch {
  text-align: center;
  color: #43a047;
  font-size: 26rpx;
  margin-top: 28rpx;
}

.hint {
  text-align: center;
  color: #bdbdbd;
  font-size: 24rpx;
  margin-top: 40rpx;
}
