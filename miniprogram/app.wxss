/* 全局样式 */
page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 24rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #222;
}

/* 主按钮 */
.btn-primary {
  background: #43a047;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  line-height: 88rpx;
  height: 88rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #c8e6c9;
  color: #fff;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-green { background: #e8f5e9; color: #43a047; }
.tag-orange { background: #fff3e0; color: #fb8c00; }
.tag-red { background: #ffebee; color: #e53935; }
.tag-blue { background: #e3f2fd; color: #1e88e5; }
.tag-gray { background: #eeeeee; color: #757575; }

/* 空状态 */
.empty {
  text-align: center;
  color: #bdbdbd;
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* 积分高亮 */
.points {
  color: #fb8c00;
  font-weight: 700;
}
